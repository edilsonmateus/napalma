generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  roda_samba
  pagode
  gafieira
  samba_rock
  feijoada_sambista
}

enum UserRole {
  admin
  producer
  venue_manager
  attendee
}

// Internal operational permissions are deliberately separate from the public
// account role. A person can assist a specific queue without becoming a global
// application administrator.
enum OperationScope {
  privacy
  claims
  catalog
  partners
  notifications
  audit
  settings
  communications
  documents
}

// Legal documents have their own version history. This is intentionally
// separate from simple privacy preferences so ordinary app settings never
// become a contractual acceptance flow.
enum LegalDocumentCategory {
  terms_of_use
  privacy_cookies
  content_moderation
  claim_management
  advertising_terms
  patacos_policy
  partnership_terms
  internal_operations
}

enum LegalDocumentVersionStatus {
  draft
  in_review
  approved
  scheduled
  active
  replaced
  archived
}

enum LegalDocumentAudience {
  visitor
  user
  artist_manager
  venue_manager
  producer
  advertiser
  strategic_partner
  internal_operator
}

enum LegalDocumentChangeType {
  editorial
  material
}

// A document acceptance is a separate, append-only proof event. It must not
// be conflated with preference consent, which a person can change freely.
enum LegalDocumentAcceptanceAction {
  accepted
  declined
}

enum LegalDocumentAcceptanceContext {
  account_signup
  account_review
  artist_claim
  venue_claim
  advertiser_access
  advertiser_campaign
  patacos_purchase
}

// An advanced signature is deliberately distinct from a click-through
// acceptance. It freezes the exact document text and records the independent
// confirmations used for each signatory.
enum LegalSignatureEnvelopeStatus {
  draft
  pending_signature
  completed
  declined
  expired
  cancelled
}

enum LegalSignatureParticipantStatus {
  pending
  viewed
  signed
  declined
  expired
}

enum LegalSignatureEvidenceMethod {
  password
  email_code
  webauthn
}

enum OperationCommunicationRecipientType {
  venue_producer
  partner_brand
  user
}

enum OperationCommunicationStatus {
  draft
  sent
  failed
}

enum StrategicPartnerType {
  operation
  project
  activation
  institutional
  other
}

enum StrategicPartnerStatus {
  prospect
  negotiating
  active
  paused
  closed
}

enum AdCampaignStatus {
  draft
  active
  paused
  ended
}

enum AdSlot {
  explore_feed_large
  venue_detail_inline
  radar_header
  venue_menu_sponsor
}

enum VenueMenuStatus {
  draft
  published
  archived
}

enum VenueMenuItemStatus {
  draft
  published
  unavailable
  archived
}

enum VenueMenuPriceMode {
  exact
  from
  hidden
  consultation
}

enum VenueMenuInteractionType {
  want_to_try
  recommend
  save
}

enum AdEventType {
  impression
  click
}

enum AdReviewStatus {
  draft
  pending_review
  approved
  rejected
  changes_requested
}

enum AdReviewEntityType {
  campaign
  creative
}

enum AdReviewAction {
  submit
  approve
  reject
  request_changes
  reopen_after_edit
}

enum AdvertiserAccountType {
  unclassified
  venue
  producer
  artist
  brand
  agency
  group
  internal
}

enum AdvertiserAccountStatus {
  draft
  pending_review
  active
  suspended
  rejected
  archived
}

enum AdvertiserMembershipRole {
  owner
  admin
  campaign_manager
  analyst
  billing_manager
  viewer
}

enum AdvertiserMembershipStatus {
  invited
  active
  suspended
  revoked
}

enum AdPaymentProvider {
  mock
  mercado_pago
}

enum AdPaymentStatus {
  created
  pending
  approved
  rejected
  cancelled
  expired
  refunded
}

enum AdCreditLedgerType {
  purchase
  experience_grant
  experience_expired
  campaign_allocation
  delivery_charge
  campaign_refund
  payment_refund
  admin_adjustment
}

enum AdExperienceGrantStatus {
  active
  consumed
  expired
  cancelled
}

enum AdCampaignCreditSource {
  purchased
  experience
}

enum ClaimTargetType {
  venue
  artist
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum ArtistAccessRole {
  owner
  manager
  editor
  viewer
}

enum ArtistAccessStatus {
  invited
  active
  suspended
  revoked
}

enum ArtistBookingStatus {
  new
  in_conversation
  proposal_sent
  won
  lost
  archived
  spam
}

enum ArtistMediaType {
  photo
  video_external
}

enum PrivacyConsentPurpose {
  cultural_personalization
  ads_personalization
}

enum PrivacyRequestType {
  access
  data_export
  deletion
  anonymization
  correction
  opposition
}

enum PrivacyRequestStatus {
  received
  in_review
  completed
  rejected
  cancelled
}

model User {
  id                              String    @id @default(uuid())
  email                           String    @unique
  username                        String    @unique
  firstName                       String
  lastName                        String
  phone                           String?
  instagramHandle                 String?
  avatarUrl                       String?
  city                            String?
  neighborhood                    String?
  postalCode                      String?
  passwordHash                    String
  role                            UserRole  @default(attendee)
  canUseReservedBrandUsername     Boolean   @default(false)
  reservedUsernameGrantedByUserId String?
  reservedUsernameGrantedAt       DateTime?

  markedEvents                 MarkedEvent[]
  historyEntries               UserEventHistory[]
  achievements                 UserAchievement[]
  createdVenues                Venue[]                       @relation("VenueCreatedBy")
  managedVenues                Venue[]                       @relation("VenueManagedBy")
  venueAccesses                VenueManagerAccess[]
  createdArtists               Artist[]                      @relation("ArtistCreatedBy")
  createdEvents                Event[]                       @relation("EventCreatedBy")
  refreshTokens                RefreshToken[]
  passwordResetTokens          PasswordResetToken[]
  adCampaigns                  AdCampaign[]
  adEvents                     AdEventLog[]
  itineraries                  Itinerary[]
  audienceVisits               AudienceVisitor[]
  pushSubscriptions            PushSubscription[]
  eventReminders               EventReminder[]
  radarEventRemindersEnabled   Boolean                    @default(false)
  toNaPistaSessions            ToNaPistaSession[]
  producerVenueAccesses        ProducerVenueAccess[]
  producerArtistAccesses       ProducerArtistAccess[]
  artistFollows                ArtistFollow[]
  claims                       ClaimRequest[]                @relation("ClaimRequestedBy")
  claimsReviewed               ClaimRequest[]                @relation("ClaimReviewedBy")
  createdRegions               Region[]                      @relation("RegionCreatedBy")
  acquisitionLeads             AcquisitionLead[]             @relation("AcquisitionLeadCreatedBy")
  acquisitionInteractions      AcquisitionInteraction[]      @relation("AcquisitionInteractionCreatedBy")
  acquisitionStatusChanges     AcquisitionStatusHistory[]    @relation("AcquisitionStatusChangedBy")
  advertiserAccountsCreated    AdvertiserAccount[]           @relation("AdvertiserAccountCreatedBy")
  advertiserAccountsApproved   AdvertiserAccount[]           @relation("AdvertiserAccountApprovedBy")
  advertiserMemberships        AdvertiserMembership[]        @relation("AdvertiserMembershipUser")
  advertiserMembershipInvites  AdvertiserMembership[]        @relation("AdvertiserMembershipInvitedBy")
  adCampaignReviews            AdCampaign[]                  @relation("AdCampaignReviewedBy")
  adCreativeReviews            AdCreative[]                  @relation("AdCreativeReviewedBy")
  adReviewActions              AdReviewLog[]                 @relation("AdReviewLogActor")
  adPaymentOrdersCreated       AdPaymentOrder[]              @relation("AdPaymentOrderCreatedBy")
  adCreditEntriesCreated       AdCreditLedgerEntry[]         @relation("AdCreditLedgerEntryCreatedBy")
  adExperienceGrantsCreated    AdExperienceGrant[]           @relation("AdExperienceGrantCreatedBy")
  artistAccesses               ArtistAccess[]                @relation("ArtistAccessUser")
  artistAccessInvites          ArtistAccess[]                @relation("ArtistAccessInvitedBy")
  artistsVerified              Artist[]                      @relation("ArtistVerifiedBy")
  artistBookingRequests        ArtistBookingRequest[]        @relation("ArtistBookingRequester")
  privacyConsentRecords        PrivacyConsentRecord[]
  privacyRequests              PrivacyRequest[]              @relation("PrivacyRequestRequester")
  privacyRequestsHandled       PrivacyRequest[]              @relation("PrivacyRequestHandledBy")
  auditLogs                    AuditLog[]                    @relation("AuditLogActor")
  venueMenuInteractions        VenueMenuInteraction[]
  menuReviews                  VenueMenu[]                   @relation("VenueMenuReviewedBy")
  menuAdInventoryAcceptances   VenueMenu[]                   @relation("VenueMenuAdInventoryAcceptedBy")
  operationAccessGrants        OperationAccessGrant[]        @relation("OperationAccessGrantUser")
  operationAccessGrantsIssued  OperationAccessGrant[]        @relation("OperationAccessGrantIssuer")
  operationWebAuthnCredentials OperationWebAuthnCredential[]
  operationWebAuthnChallenges  OperationWebAuthnChallenge[]
  operationCommunicationMessages OperationCommunicationMessage[] @relation("OperationCommunicationAuthor")
  legalDocumentAcceptances     LegalDocumentAcceptance[]
  signatureEnvelopesCreated    LegalSignatureEnvelope[]       @relation("LegalSignatureEnvelopeCreatedBy")
  legalSignatureParticipants   LegalSignatureParticipant[]    @relation("LegalSignatureParticipantUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperationAccessGrant {
  id              String         @id @default(uuid())
  userId          String
  scope           OperationScope
  grantedByUserId String
  createdAt       DateTime       @default(now())
  revokedAt       DateTime?

  user      User @relation("OperationAccessGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("OperationAccessGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([userId, scope])
  @@index([userId, revokedAt])
  @@index([scope, revokedAt])
}

model OperationWebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   Json?
  deviceType   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OperationWebAuthnChallenge {
  id        String    @id @default(uuid())
  userId    String
  purpose   String
  challenge String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

model PrivacyConsentRecord {
  id            String                @id @default(uuid())
  userId        String
  purpose       PrivacyConsentPurpose
  policyVersion String
  isGranted     Boolean
  source        String                @default("privacy_center")
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model PrivacyRequest {
  id              String               @id @default(uuid())
  userId          String
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(received)
  details         String?
  requestedAt     DateTime             @default(now())
  dueAt           DateTime?
  resolvedAt      DateTime?
  handledByUserId String?
  resolutionNote  String?

  user      User  @relation("PrivacyRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("PrivacyRequestHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([status, dueAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  subjectType String
  subjectId   String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([action, createdAt])
}

// Commercial details are intentionally stored apart from public catalogue
// concerns. Only an active, public and currently valid partner is exposed by
// the public endpoint.
model StrategicPartner {
  id                      String                 @id @default(uuid())
  name                    String
  logoUrl                 String?
  publicDescription       String?                @db.VarChar(600)
  internalNotes           String?                @db.Text
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  partnershipType         StrategicPartnerType   @default(other)
  counterpartAgreements   String?                @db.Text
  status                  StrategicPartnerStatus @default(prospect)
  startsAt                DateTime?
  endsAt                  DateTime?
  isPermanent             Boolean                @default(false)
  publicVisible           Boolean                @default(false)
  displayOrder            Int                    @default(0)
  initiativeName          String?
  destinationUrl          String?
  activationStartsAt      DateTime?
  activationEndsAt        DateTime?
  canAppearAsSupporter    Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([status, publicVisible, displayOrder])
  @@index([endsAt])
}

// Individual institutional messages are stored as a protected operational
// record. Recipient data is kept as a snapshot so the communication history
// remains useful even when a public profile later changes or is removed.
model OperationCommunicationMessage {
  id                    String                              @id @default(uuid())
  recipientName         String?
  recipientEmail        String?
  recipientType         OperationCommunicationRecipientType?
  recipientReferenceId  String?
  subject               String                              @default("") @db.VarChar(220)
  contentHtml           String                              @default("") @db.Text
  contentText           String                              @default("") @db.Text
  templateKey           String?                             @db.VarChar(80)
  includePartnerRail    Boolean                             @default(false)
  status                OperationCommunicationStatus       @default(draft)
  failureReason         String?                             @db.VarChar(500)
  sentAt                DateTime?
  authorUserId          String
  author                User                                @relation("OperationCommunicationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  @@index([status, updatedAt])
  @@index([recipientEmail, createdAt])
  @@index([authorUserId, updatedAt])
}

// The catalogue is an operational source of truth. A document may be public
// eventually, but no version is exposed or used for acceptance until it is
// explicitly made active in a later rollout.
model LegalDocument {
  id        String                @id @default(uuid())
  key       String                @unique @db.VarChar(80)
  title     String                @db.VarChar(180)
  category  LegalDocumentCategory
  summary   String?               @db.VarChar(500)
  isPublic  Boolean               @default(false)
  versions  LegalDocumentVersion[]
  acceptances LegalDocumentAcceptance[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([category, isPublic])
}

model LegalDocumentVersion {
  id                       String                     @id @default(uuid())
  documentId               String
  versionLabel             String                     @db.VarChar(32)
  status                   LegalDocumentVersionStatus @default(draft)
  contentText              String                     @default("") @db.Text
  contentSha256            String                     @db.VarChar(64)
  sourceDocumentUrl        String?                    @db.VarChar(1000)
  sourceDocumentSha256     String?                    @db.VarChar(64)
  changeType               LegalDocumentChangeType    @default(material)
  changeSummary            String?                    @db.VarChar(1000)
  requiresReacceptance     Boolean                    @default(false)
  effectiveAt              DateTime?
  reviewedAt               DateTime?
  reviewedByUserId         String?
  approvedAt               DateTime?
  approvedByUserId         String?
  publishedAt              DateTime?
  publishedByUserId        String?
  replacedAt               DateTime?
  createdByUserId          String
  audiences                LegalDocumentVersionAudience[]
  acceptances              LegalDocumentAcceptance[]
  signatureEnvelopes       LegalSignatureEnvelope[]
  document                 LegalDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([documentId, versionLabel])
  @@index([documentId, status])
  @@index([status, effectiveAt])
}

model LegalDocumentVersionAudience {
  id        String                @id @default(uuid())
  versionId String
  audience  LegalDocumentAudience
  version   LegalDocumentVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, audience])
  @@index([audience])
}

// Immutable evidence that a specific authenticated user accepted a specific
// content hash. New document versions create new evidence; historic records
// are never overwritten when a policy changes.
model LegalDocumentAcceptance {
  id              String                         @id @default(uuid())
  userId          String
  documentId      String
  versionId       String
  audience        LegalDocumentAudience
  context         LegalDocumentAcceptanceContext
  action          LegalDocumentAcceptanceAction  @default(accepted)
  versionLabel    String                         @db.VarChar(32)
  contentSha256   String                         @db.VarChar(64)
  source          String                         @default("in_app") @db.VarChar(60)
  userAgent       String?                        @db.VarChar(512)
  ipHash          String?                        @db.VarChar(64)
  metadata        Json?
  acceptedAt      DateTime                       @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([userId, documentId, acceptedAt])
  @@index([userId, versionId, context])
  @@index([versionId, action])
  @@index([documentId, acceptedAt])
}

// The envelope preserves a complete, immutable snapshot even if the source
// document receives a later version. A participant can sign only their own
// authenticated envelope; raw passwords and one-time codes are never stored.
model LegalSignatureEnvelope {
  id                    String                       @id @default(uuid())
  protocol              String                       @unique @db.VarChar(40)
  title                 String                       @db.VarChar(220)
  documentVersionId     String
  documentTitleSnapshot String                       @db.VarChar(220)
  versionLabelSnapshot  String                       @db.VarChar(32)
  contentSnapshot       String                       @db.Text
  contentSha256         String                       @db.VarChar(64)
  status                LegalSignatureEnvelopeStatus @default(draft)
  expiresAt             DateTime?
  sentAt                DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?                      @db.VarChar(600)
  createdByUserId       String
  documentVersion       LegalDocumentVersion         @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  createdBy             User                         @relation("LegalSignatureEnvelopeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants          LegalSignatureParticipant[]
  events                LegalSignatureEvent[]
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([status, expiresAt])
  @@index([documentVersionId, createdAt])
}

model LegalSignatureParticipant {
  id                    String                         @id @default(uuid())
  envelopeId            String
  userId                String?
  nameSnapshot          String                         @db.VarChar(180)
  emailSnapshot         String                         @db.VarChar(320)
  roleLabel             String?                        @db.VarChar(120)
  signingOrder          Int                            @default(1)
  status                LegalSignatureParticipantStatus @default(pending)
  invitationTokenHash   String                         @unique @db.VarChar(64)
  invitationExpiresAt   DateTime
  invitationSentAt      DateTime?
  viewedAt              DateTime?
  signedAt              DateTime?
  declinedAt            DateTime?
  declineReason         String?                        @db.VarChar(600)
  emailCodeHash         String?                        @db.VarChar(64)
  emailCodeExpiresAt    DateTime?
  emailCodeUsedAt       DateTime?
  envelope              LegalSignatureEnvelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  user                  User?                          @relation("LegalSignatureParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  evidences             LegalSignatureEvidence[]
  events                LegalSignatureEvent[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([envelopeId, emailSnapshot])
  @@index([userId, status])
  @@index([envelopeId, status])
}

model LegalSignatureEvidence {
  id            String                       @id @default(uuid())
  participantId String
  method        LegalSignatureEvidenceMethod
  contentSha256 String                       @db.VarChar(64)
  userAgent     String?                      @db.VarChar(512)
  ipHash        String?                      @db.VarChar(64)
  metadata      Json?
  recordedAt    DateTime                     @default(now())
  participant   LegalSignatureParticipant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, recordedAt])
}

model LegalSignatureEvent {
  id            String                  @id @default(uuid())
  envelopeId    String
  participantId String?
  actorUserId   String?
  action        String                  @db.VarChar(80)
  metadata      Json?
  ipHash        String?                 @db.VarChar(64)
  createdAt     DateTime                @default(now())
  envelope      LegalSignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  participant   LegalSignatureParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([envelopeId, createdAt])
  @@index([participantId, createdAt])
}

model Region {
  id                         String   @id @default(uuid())
  name                       String
  city                       String   @default("Sao Paulo")
  state                      String   @default("SP")
  grammarArticle             String?
  grammarPreposition         String?  @default("em")
  displayNameWithArticle     String?
  displayNameWithPreposition String?
  isActive                   Boolean  @default(true)
  sortOrder                  Int      @default(0)
  createdByUserId            String?
  createdBy                  User?    @relation("RegionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([name, city, state])
  @@index([isActive, sortOrder, name])
}

model AudienceVisitor {
  id          String    @id @default(uuid())
  visitorId   String    @unique
  userId      String?
  linkedAt    DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  hits        Int       @default(1)

  user User? @relation(fields: [userId], references: [id])

  @@index([lastSeenAt])
  @@index([userId])
  @@index([linkedAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  authKey   String
  userId    String?
  visitorId String?
  platform  String?
  userAgent String?
  isActive  Boolean  @default(true)
  deviceLabel String?
  lastSeenAt DateTime @default(now())
  disabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  reminderDeliveries EventReminderDelivery[]

  @@index([userId])
  @@index([visitorId])
  @@index([isActive])
}

model ToNaPistaSession {
  id                String   @id @default(uuid())
  userId            String?
  visitorId         String?
  latitude          Float
  longitude         Float
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  maxNotifications  Int      @default(2)
  notificationsSent Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries ToNaPistaDelivery[]

  @@index([userId, isActive, expiresAt])
  @@index([visitorId, isActive, expiresAt])
}

model ToNaPistaDelivery {
  id        String   @id @default(uuid())
  sessionId String
  eventId   String
  sentAt    DateTime @default(now())

  session ToNaPistaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event   Event            @relation(fields: [eventId], references: [id])

  @@unique([sessionId, eventId])
  @@index([eventId, sentAt])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  visitorId String?
  userId    String?
  venueId   String?
  eventId   String?
  artistId  String?
  region    String?
  city      String?
  state     String?
  source    String?
  metadata  Json?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([venueId, type, createdAt])
  @@index([eventId, type, createdAt])
  @@index([artistId, type, createdAt])
  @@index([region, createdAt])
  @@index([city, createdAt])
}

model Itinerary {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  date                DateTime
  mode                String   @default("manual") // manual | automatic
  status              String   @default("draft") // draft | active | completed
  totalTransitMinutes Int      @default(0)
  riskScore           Int      @default(0)
  shareToken          String?  @unique
  shareEnabledAt      DateTime?
  shareExpiresAt      DateTime?
  shareRevokedAt      DateTime?

  user  User            @relation(fields: [userId], references: [id])
  items ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model ItineraryItem {
  id                     String @id @default(uuid())
  itineraryId            String
  eventId                String
  position               Int
  transitMinutesFromPrev Int    @default(0)
  riskLevel              String @default("ok") // ok | tight | risky

  itinerary Itinerary @relation(fields: [itineraryId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itineraryId, eventId])
  @@unique([itineraryId, position])
  @@index([eventId])
}

model AdCampaign {
  id                      String           @id @default(uuid())
  advertiser              String
  name                    String
  status                  AdCampaignStatus @default(draft)
  startsAt                DateTime?
  endsAt                  DateTime?
  priority                Int              @default(1)
  frequencyCapDaily       Int              @default(3)
  runInAllSlots           Boolean          @default(false)
  isEnabled               Boolean          @default(true)
  targeting               Json?
  createdByUserId         String?
  advertiserAccountId     String?
  reviewStatus            AdReviewStatus?
  submittedAt             DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  reviewedByUserId        String?
  reviewNotes             String?
  requiresReviewAfterEdit Boolean          @default(false)
  budgetCredits           Int              @default(0)
  spentCredits            Int              @default(0)
  // Financeiro V2: a fonte de verdade usa inteiros em milipatacos.
  budgetMilipatacos       BigInt           @default(0)
  reservedMilipatacos     BigInt           @default(0)
  spentMilipatacos        BigInt           @default(0)
  pricingSnapshot         Json?
  pricingVersion          String?

  createdBy         User?                 @relation(fields: [createdByUserId], references: [id])
  advertiserAccount AdvertiserAccount?    @relation(fields: [advertiserAccountId], references: [id], onDelete: SetNull)
  reviewedBy        User?                 @relation("AdCampaignReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  creatives         AdCreative[]
  events            AdEventLog[]
  deliveries        AdDelivery[]
  paymentOrders     AdPaymentOrder[]
  creditEntries     AdCreditLedgerEntry[]
  creditAllocations AdCampaignCreditAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserAccountId, status])
  @@index([reviewStatus, submittedAt])
}

model AdvertiserAccount {
  id                 String                  @id @default(uuid())
  name               String
  type               AdvertiserAccountType   @default(unclassified)
  status             AdvertiserAccountStatus @default(draft)
  source             String                  @default("manual")
  legacyKey          String?                 @unique
  legalName          String?
  documentNumber     String?
  contactEmail       String?
  contactPhone       String?
  notes              String?
  commercialCategory String?
  createdByUserId    String?
  approvedByUserId   String?
  approvedAt         DateTime?

  createdBy     User?                  @relation("AdvertiserAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy    User?                  @relation("AdvertiserAccountApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  memberships   AdvertiserMembership[]
  campaigns     AdCampaign[]
  wallet        AdvertiserWallet?
  paymentOrders AdPaymentOrder[]
  creditEntries AdCreditLedgerEntry[]
  experienceGrants AdExperienceGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([name])
}

model AdvertiserWallet {
  id        String   @id @default(uuid())
  accountId String   @unique
  balance   Int      @default(0)
  balanceMilipatacos BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account AdvertiserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// Bônus de experimentação não entram na carteira financeira. Cada concessão
// preserva prazo, origem e responsável para auditoria e rebonificação.
model AdExperienceGrant {
  id                   String                  @id @default(uuid())
  accountId            String
  originalMilipatacos  BigInt
  remainingMilipatacos BigInt                  @default(0)
  expiredMilipatacos   BigInt                  @default(0)
  status               AdExperienceGrantStatus @default(active)
  reason               String                  @db.VarChar(500)
  note                 String?                 @db.Text
  overrideReason       String?                 @db.Text
  expiresAt            DateTime
  grantedByUserId      String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  account     AdvertiserAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grantedBy   User                          @relation("AdExperienceGrantCreatedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  allocations AdCampaignCreditAllocation[]

  @@index([accountId, status, expiresAt])
  @@index([createdAt])
}

// A reserva da campanha sabe de qual fonte veio. Assim, crédito promocional
// pode expirar ou voltar ao lote sem alterar a verba adquirida.
model AdCampaignCreditAllocation {
  id                   String                   @id @default(uuid())
  campaignId           String
  experienceGrantId    String?
  source               AdCampaignCreditSource
  originalMilipatacos  BigInt
  reservedMilipatacos  BigInt                   @default(0)
  spentMilipatacos     BigInt                   @default(0)
  expiredMilipatacos   BigInt                   @default(0)
  expiresAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  campaign        AdCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  experienceGrant AdExperienceGrant?  @relation(fields: [experienceGrantId], references: [id], onDelete: SetNull)

  @@index([campaignId, source])
  @@index([experienceGrantId])
  @@index([expiresAt])
}

model AdPaymentOrder {
  id                String            @id @default(uuid())
  accountId         String
  campaignId        String?
  provider          AdPaymentProvider @default(mock)
  status            AdPaymentStatus   @default(created)
  packageCode       String
  amountCents       Int
  creditAmount      Int

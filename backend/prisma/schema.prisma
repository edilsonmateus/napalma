enum EventReminderType {
  EVENT_START_3H
}

enum EventReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

model EventReminder {
  id                 String              @id @default(uuid())
  userId             String
  eventId            String
  type               EventReminderType   @default(EVENT_START_3H)
  scheduledFor       DateTime
  status             EventReminderStatus @default(PENDING)
  eventStartSnapshot DateTime
  sentAt             DateTime?
  cancelledAt        DateTime?
  failureReason      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries EventReminderDelivery[]

  @@unique([userId, eventId, type])
  @@index([status, scheduledFor])
  @@index([eventId, status])
}

model EventReminderDelivery {

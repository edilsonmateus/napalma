  subscription PushSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([reminderId, subscriptionId])
  @@index([reminderId, createdAt])
}

model UserEventHistory {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

model Achievement {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String
  icon        String
  points      Int
  requirement Json

  users UserAchievement[]
}

model UserAchievement {
  id            String @id @default(uuid())
  userId        String
  achievementId String

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
}

model ClaimRequest {
  id                          String          @id @default(uuid())
  requestedById               String
  targetType                  ClaimTargetType
  venueId                     String?
  artistId                    String?
  responsibleName             String?
  responsiblePhone            String?
  claimantDocument            String?
  relationshipRole            String?
  officialEmail               String?
  officialInstagram           String?
  officialWebsite             String?
  justification               String?
  requestType                 String          @default("ownership")
  requestedChanges            Json?
  legalAcknowledgedAt         DateTime?
  legalAcknowledgementVersion String?
  status                      ClaimStatus     @default(pending)
  reviewedById                String?
  reviewedAt                  DateTime?
  decisionNote                String?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  requestedBy User    @relation("ClaimRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ClaimReviewedBy", fields: [reviewedById], references: [id])
  venue       Venue?  @relation("ClaimVenue", fields: [venueId], references: [id])
  artist      Artist? @relation("ClaimArtist", fields: [artistId], references: [id])

  @@index([requestedById, status])
  @@index([targetType, status])
}

model AcquisitionLead {
  id                 String                     @id @default(uuid())
  venueName          String
  city               String                     @default("São Paulo")
  region             String?
  neighborhood       String?
  address            String?
  addressNumber      String?
  addressComplement  String?
  zipCode            String?
  latitude           Float?
  longitude          Float?
  instagramUrl       String?
  phone              String?
  contactName        String?
  contactRole        String?
  email              String?
  status             String                     @default("mapped")
  temperature        String                     @default("warm")
  nextFollowUpAt     DateTime?
  presentationAt     DateTime?
  presentationFormat String?
  source             String?
  potential          String?
  objections         String?
  notes              String?
  convertedVenueId   String?                    @unique
  convertedAt        DateTime?
  convertedByUserId  String?
  createdByUserId    String?
  createdBy          User?                      @relation("AcquisitionLeadCreatedBy", fields: [createdByUserId], references: [id])
  convertedVenue     Venue?                     @relation("AcquisitionLeadConvertedVenue", fields: [convertedVenueId], references: [id])
  interactions       AcquisitionInteraction[]
  statusHistory      AcquisitionStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([temperature])
  @@index([nextFollowUpAt])
  @@index([city, region])
}

model AcquisitionStatusHistory {
  id              String   @id @default(uuid())
  leadId          String
  fromStatus      String?
  toStatus        String
  changedByUserId String?
  changedAt       DateTime @default(now())

  lead      AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User?           @relation("AcquisitionStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([leadId, changedAt])
  @@index([toStatus, changedAt])
  @@index([changedByUserId, changedAt])
}

model AcquisitionInteraction {
  id              String    @id @default(uuid())
  leadId          String
  type            String    @default("note")
  summary         String
  nextAction      String?
  nextFollowUpAt  DateTime?
  createdByUserId String?

  lead      AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AcquisitionInteractionCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([nextFollowUpAt])
}
